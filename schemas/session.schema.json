{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lensless holography workbench session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_id",
    "test_id",
    "status",
    "status_reason",
    "environment",
    "units",
    "parameters",
    "selected_depth_um",
    "inputs",
    "scan",
    "outputs",
    "comparison"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "product_id": { "const": "U02" },
    "test_id": { "const": "U02-T2" },
    "status": { "const": "BEKLİYOR" },
    "status_reason": { "type": "string", "minLength": 1 },
    "environment": {
      "type": "object",
      "required": ["python", "python_implementation", "numpy", "pillow"]
    },
    "units": {
      "type": "object",
      "required": ["depth", "gradient_energy", "amplitude_std", "selected_plane"]
    },
    "parameters": {
      "type": "object",
      "required": [
        "pixel_pitch_um",
        "wavelength_um",
        "refractive_index",
        "depth_start_um",
        "depth_stop_um",
        "depth_step_um",
        "roi_size_px"
      ]
    },
    "selected_depth_um": { "type": "number" },
    "inputs": { "type": "array" },
    "scan": { "type": "object" },
    "outputs": { "type": "object" },
    "comparison": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["acceptance_threshold", "acceptance_result"],
          "properties": {
            "acceptance_threshold": { "type": "null" },
            "acceptance_result": { "const": "NOT_EVALUATED" }
          }
        }
      ]
    }
  }
}

